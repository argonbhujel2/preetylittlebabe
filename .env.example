# Required — long random string in production
SECRET_KEY=replace-with-a-long-random-secret

ADMIN_USERNAME=argon
ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Prefer hash in production:
# ADMIN_PASSWORD_HASH=pbkdf2:sha256:...

# Neon Postgres connection string (optional but recommended for production settings)
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Public site origin (HTTPS on Vercel / custom domain)
CORS_ORIGINS=https://your-app.vercel.app

PORT=5000
FLASK_DEBUG=0

# Optional email notifications
NOTIFY_EMAIL_TO=
SMTP_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
